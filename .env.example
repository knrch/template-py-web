# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
LOG_LEVEL=INFO
SENTRY_DSN=
# Optional knobs (defaults shown).
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Frontend (vite needs VITE_ prefix to expose to client)
VITE_API_URL=http://localhost:8000
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# Tracing — fraction of transactions sampled (0.0–1.0).
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Session Replay — 0.0 to disable in steady state. Errors below still record.
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
# Set at deploy time so releases group by SHA. Locally leave blank.
VITE_GIT_SHA=

# Frontend build-time only (Vite picks these up via loadEnv; NOT shipped to
# the browser). Activates @sentry/vite-plugin source-map upload when all
# three are set — typically only in CI.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Storage (S3-compatible — works with R2, B2, MinIO, S3)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Smoke target (Railway URL after deploy)
SMOKE_URL=http://localhost:8000
