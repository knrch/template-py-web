{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":pinDevDependencies"],
  "schedule": ["before 6am on monday"],
  "timezone": "Asia/Tokyo",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Auto-merge dev tooling minor/patch",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Pin GitHub Actions to SHAs",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Group Chainguard image bumps",
      "matchPackagePatterns": ["^cgr.dev/chainguard/"],
      "groupName": "chainguard images"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
