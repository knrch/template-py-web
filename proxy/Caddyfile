# Caddy reverse proxy. Local dev: routes /api/* → backend, /* → frontend.
# Production on Railway: replace `:80` with your domain and let Caddy
# auto-provision TLS.

:80 {
    log {
        output stdout
        format console
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:8080
    }
}
